# Vercel Project Settings -> Environment Variables
# Create a Resend account, verify facktsafrica.co.ke, then add:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=FACKTS Website <website@facktsafrica.co.ke>

# Private server-to-server lead delivery to the FACKTS Africa CRM.
# Keep this secret server-only, never use NEXT_PUBLIC_ or include it in client code.
FACKTS_CRM_URL=https://backoffice.facktsafrica.co.ke
FACKTS_CRM_WEBHOOK_SECRET=
